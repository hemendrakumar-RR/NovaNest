# NovaNest Streamlit Community Cloud - Secrets Configuration Template
# ======================================================================
# Place your secrets in the Streamlit Community Cloud dashboard:
# App Settings -> Secrets
# For local testing, copy this file to .streamlit/secrets.toml (NEVER commit secrets.toml).

# ----------------------------------------------------------------------
# 1. NovaNest FastAPI Backend Integration
# ----------------------------------------------------------------------
# Point to your publicly hosted NovaNest FastAPI backend (e.g., Render, Railway, DigitalOcean, VPS)
NOVANEST_API_URL = "https://api.novanest.example.com"
NOVANEST_API_KEY = "your-secure-operator-api-key"
NOVANEST_ADMIN_KEY = "your-secure-admin-api-key"
NOVANEST_VIEWER_KEY = "your-secure-viewer-api-key"

# ----------------------------------------------------------------------
# 2. Database Connectivity (Optional Cloud MySQL)
# ----------------------------------------------------------------------
# If you host a cloud MySQL database (e.g. Aiven MySQL, PlanetScale, AWS RDS, DigitalOcean Managed MySQL),
# set DATA_SOURCE = "mysql" and fill in the credentials below.
# If omitted or left as "csv", the app seamlessly uses the bundled 10 cleaned & 9 engineered CSV datasets
# with identical canonical counts and calculations.
DATA_SOURCE = "csv"

# Cloud MySQL Configuration (Root format):
DB_HOST = "your-cloud-mysql-host.example.com"
DB_PORT = 3306
DB_USER = "novanest_app"
DB_PASSWORD = "your-cloud-database-password"
DB_NAME = "novanest_db"

# Or Cloud MySQL Configuration (Section format):
# [mysql]
# host = "your-cloud-mysql-host.example.com"
# port = 3306
# user = "novanest_app"
# password = "your-cloud-database-password"
# database = "novanest_db"
