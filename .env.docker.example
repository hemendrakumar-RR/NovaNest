# ==============================================================================
# NovaNest Docker Compose Environment Configuration Template (.env.docker.example)
# Copy this file to .env.docker before running: docker compose --env-file .env.docker up -d
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. MySQL Database Configuration (Container-to-Container Network)
# ------------------------------------------------------------------------------
DB_HOST=db
DB_PORT=3306
DB_NAME=novanest_db

# MySQL Root Password (Used strictly during container initialization; not used by apps)
MYSQL_ROOT_PASSWORD=REPLACE_WITH_STRONG_ROOT_PASSWORD

# Application Runtime User (FastAPI & Streamlit: Least-privilege)
DB_APP_USER=novanest_app
DB_APP_PASSWORD=REPLACE_WITH_APP_PASSWORD
DB_POOL_SIZE=5
DB_CONNECT_TIMEOUT=3

# Ingestion ETL User (Used strictly for migration/loader jobs)
DB_INGEST_USER=novanest_loader
DB_INGEST_PASSWORD=REPLACE_WITH_INGESTION_PASSWORD

# Active Data Source (mysql or csv)
DATA_SOURCE=mysql

# ------------------------------------------------------------------------------
# 2. Application Security & API Keys (Generate via: openssl rand -hex 32)
# ------------------------------------------------------------------------------
NOVANEST_API_KEY=REPLACE_WITH_HEX32_API_KEY
NOVANEST_ADMIN_KEY=REPLACE_WITH_HEX32_ADMIN_KEY
NOVANEST_VIEWER_KEY=REPLACE_WITH_HEX32_VIEWER_KEY

# Allowed CORS Origins (Include Nginx frontend origins)
CORS_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:80,http://127.0.0.1:80,http://localhost:5173

# ------------------------------------------------------------------------------
# 3. Service Internal Networking Endpoints
# ------------------------------------------------------------------------------
NOVANEST_API_URL=http://api:8000
FASTAPI_PORT=8000
STREAMLIT_PORT=8501
FRONTEND_PORT=80

# Application Environment Mode
APP_ENV=production
DEBUG=false

# ------------------------------------------------------------------------------
# 4. Optional Advanced AI Provider Keys
# ------------------------------------------------------------------------------
GEMINI_API_KEY=
OPENAI_API_KEY=
