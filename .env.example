# NovaNest Environment Configuration Template
# Copy this file to .env and configure your local settings.

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=novanest_db

# Admin User (Used ONLY for initial schema migrations via Workbench; do not use in application)
# DB_USER=root
# DB_PASSWORD=your_root_password

# Ingestion ETL User (Least-privilege for python/load_mysql.py: SELECT, INSERT)
DB_INGEST_USER=novanest_loader
DB_INGEST_PASSWORD=REPLACE_WITH_INGESTION_PASSWORD

# Application Runtime User (Least-privilege for FastAPI & Streamlit: SELECT)
DB_APP_USER=novanest_app
DB_APP_PASSWORD=REPLACE_WITH_APP_PASSWORD
DB_POOL_SIZE=5

# Application Configuration
APP_ENV=development
APP_PORT=8501
DEBUG=True

# API Security Configuration (Generate strong random keys before running FastAPI)
NOVANEST_API_KEY=
NOVANEST_ADMIN_KEY=
NOVANEST_VIEWER_KEY=
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

# AI & LLM Configuration (Optional for Advanced AI Agents)
GEMINI_API_KEY=
OPENAI_API_KEY=

