# NovaNest Environment Configuration Template
# Copy this file to .env and configure your local settings.

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=novanest_db

# Application Configuration
APP_ENV=development
APP_PORT=8501
DEBUG=True

# AI & LLM Configuration (Optional for Advanced AI Agents)
GEMINI_API_KEY=
OPENAI_API_KEY=

