{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "id": 1,
      "title": "Active Database Connections",
      "type": "stat",
      "targets": [{ "expr": "novanest_db_connections_active", "refId": "A" }]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "id": 2,
      "title": "Connection Pool Utilization",
      "type": "gauge",
      "targets": [{ "expr": "novanest_db_pool_utilization_ratio * 100", "refId": "A" }],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 75 }, { "color": "red", "value": 90 }] }
        }
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "id": 3,
      "title": "Query Throughput (qps)",
      "type": "stat",
      "targets": [{ "expr": "sum(rate(novanest_db_queries_total[1m]))", "refId": "A" }]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "id": 4,
      "title": "Database Query Errors",
      "type": "stat",
      "targets": [{ "expr": "sum(novanest_db_queries_total{status=\"failure\"})", "refId": "A" }],
      "fieldConfig": {
        "defaults": {
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] }
        }
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "id": 5,
      "title": "MySQL Query Latency by Type (p95)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(novanest_db_query_duration_seconds_bucket[5m])) by (le, query_type))",
          "legendFormat": "{{query_type}}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "id": 6,
      "title": "Query Volume by Operation Type",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(novanest_db_queries_total[5m])) by (query_type)",
          "legendFormat": "{{query_type}}",
          "refId": "A"
        }
      ]
    }
  ],
  "refresh": "15s",
  "schemaVersion": 39,
  "tags": ["novanest", "database", "mysql"],
  "time": { "from": "now-1h", "to": "now" },
  "title": "NovaNest — Database Health & MySQL Performance",
  "uid": "novanest-db-health",
  "version": 1
}