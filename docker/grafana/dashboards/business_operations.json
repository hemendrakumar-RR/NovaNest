{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "id": 1,
      "title": "[LIVE] Orders Processed Rate (ops/sec)",
      "type": "stat",
      "targets": [{ "expr": "sum(rate(novanest_api_requests_total{endpoint=~\"/api/orders.*\"}[5m]))", "refId": "A" }]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "id": 2,
      "title": "[HISTORICAL] Delivery SLA Breach Rate (>45m)",
      "type": "gauge",
      "targets": [{ "expr": "novanest_sla_breach_rate_ratio * 100", "refId": "A" }],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 25 }, { "color": "red", "value": 30 }] }
        }
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "id": 3,
      "title": "[PRESCRIPTIVE] Proposed Interventions",
      "type": "stat",
      "targets": [{ "expr": "sum(novanest_recommendations_count{status=\"proposed\"})", "refId": "A" }]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "id": 4,
      "title": "[PRESCRIPTIVE] Approved & Implemented",
      "type": "stat",
      "targets": [{ "expr": "sum(novanest_recommendations_count{status=~\"approved|implemented|in_progress\"})", "refId": "A" }],
      "fieldConfig": {
        "defaults": {
          "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }] }
        }
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "id": 5,
      "title": "[AI WORKFLOW] Domain Agent Execution Latencies (p95)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(novanest_ai_agent_duration_seconds_bucket[5m])) by (le, agent_name))",
          "legendFormat": "{{agent_name}}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "id": 6,
      "title": "[PRESCRIPTIVE] Active Recommendations by Domain",
      "type": "barchart",
      "targets": [
        {
          "expr": "sum(novanest_recommendations_count) by (domain)",
          "legendFormat": "{{domain}}",
          "refId": "A"
        }
      ]
    }
  ],
  "refresh": "15s",
  "schemaVersion": 39,
  "tags": ["novanest", "business", "prescriptive", "analytics"],
  "time": { "from": "now-1h", "to": "now" },
  "title": "NovaNest — Business Operations & Prescriptive Telemetry",
  "uid": "novanest-business-ops",
  "version": 1
